{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile tests",
      "type": "npm",
      "script": "compile",
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "test",
      "type": "npm",
      "script": "test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "package extension",
      "type": "npm",
      "script": "package:local",
      "problemMatcher": "$tsc"
    },
    {
      "label": "install extension VSIX",
      "type": "process",
      "command": "code",
      "args": [
        "--install-extension",
        "${workspaceFolder}/deckbridge-local.vsix",
        "--force"
      ],
      "problemMatcher": []
    },
    {
      "label": "install/update DeckBridge",
      "dependsOrder": "sequence",
      "dependsOn": [
        "package extension",
        "install extension VSIX"
      ],
      "problemMatcher": []
    },
    {
      "label": "publish extension to Marketplace",
      "type": "process",
      "command": "npm",
      "args": [
        "run",
        "publish:marketplace"
      ],
      "options": {
        "env": {
          "VSCE_PAT": "${input:deckbridgeMarketplaceToken}"
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "deckbridgeMarketplaceToken",
      "type": "promptString",
      "description": "Marketplace token (Marketplace > Manage)",
      "password": true
    }
  ]
}
